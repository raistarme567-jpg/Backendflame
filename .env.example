# Flame App Store (FAS) - Backend Configuration

# Server Port
PORT=5000
NODE_ENV="development"

# Cross-Origin Resource Sharing (Frontend URL)
CORS_ORIGIN="http://localhost:5173"

# Google Gemini API Key (Trainer & Infinity Language Engine)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Database Connection (PostgreSQL via Prisma ORM)
DATABASE_URL="postgresql://postgres:flamepassword@localhost:5432/flame_app_store?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="flame_fas_access_super_secret_key_change_in_prod"
JWT_REFRESH_SECRET="flame_fas_refresh_super_secret_key_change_in_prod"

# Object Storage Configuration (Local or Cloud S3)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="flame-apk-storage"
STORAGE_REGION="us-east-1"
